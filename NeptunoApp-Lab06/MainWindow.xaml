<Window x:Class="NeptunoApp_Lab06.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NeptunoApp_Lab06.Views"
        Title="NeptunoApp - Lab 06" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#fedae7">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#81488a">
            <StackPanel Margin="0,30,0,0">
                <TextBlock Text="NEPTUNO DB" FontSize="22" FontWeight="Bold" 
                           Foreground="#df95ba" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <Button Content="📦 Productos" Click="BtnProductos_Click" FontSize="16" Padding="20,15" 
                        HorizontalContentAlignment="Left" Cursor="Hand" Background="Transparent" 
                        Foreground="#df95ba" BorderThickness="0"/>

                <Button Content="🗂️ Categorías" Click="BtnCategorias_Click" FontSize="16" Padding="20,15" 
                        HorizontalContentAlignment="Left" Cursor="Hand" Background="Transparent" 
                        Foreground="#df95ba" BorderThickness="0"/>

                <Button Content="🚚 Proveedores" Click="BtnProveedores_Click" FontSize="16" Padding="20,15" 
                        HorizontalContentAlignment="Left" Cursor="Hand" Background="Transparent" 
                        Foreground="#df95ba" BorderThickness="0"/>

                <Button Content="📋 Pedidos" Click="BtnPedidos_Click" FontSize="16" Padding="20,15" 
                        HorizontalContentAlignment="Left" Cursor="Hand" Background="Transparent" 
                        Foreground="#df95ba" BorderThickness="0"/>
                <Button Content="📊 Reportes" Click="BtnReportes_Click" FontSize="16" Padding="20,15" 
        HorizontalContentAlignment="Left" Cursor="Hand" Background="Transparent" 
        Foreground="#df95ba" BorderThickness="0"/>
                
            </StackPanel>
        </Border>

        <!-- ContentControl para cargar las vistas -->
        <Border Grid.Column="1" Background="#fedae7" Padding="20">
            <ContentControl x:Name="MainContent" />
        </Border>
    </Grid>
</Window>