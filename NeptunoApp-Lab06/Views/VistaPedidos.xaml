<UserControl x:Class="NeptunoApp_Lab06.Views.VistaPedidos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Mantenimiento de Pedidos" Grid.Row="0" Padding="10" Margin="0,0,0,10"
                  BorderBrush="#81488a" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 1: ComboBox EDITABLES -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="5">
                    <TextBlock Text="Cliente:" FontWeight="Bold" Foreground="#81488a"/>
                    <ComboBox ItemsSource="{Binding ClientesDT}" 
                              DisplayMemberPath="Empresa" 
                              SelectedValuePath="ClienteID" 
                              SelectedValue="{Binding ClienteID}" 
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Margin="5">
                    <TextBlock Text="Empleado:" FontWeight="Bold" Foreground="#81488a"/>
                    <ComboBox ItemsSource="{Binding EmpleadosDT}" 
                              DisplayMemberPath="NombreCompleto" 
                              SelectedValuePath="EmpleadoID" 
                              SelectedValue="{Binding EmpleadoID}" 
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0" Margin="5">
                    <TextBlock Text="Transportista:" FontWeight="Bold" Foreground="#81488a"/>
                    <ComboBox ItemsSource="{Binding TransportistasDT}" 
                              DisplayMemberPath="CompaniaNombre" 
                              SelectedValuePath="TransportistaID" 
                              SelectedValue="{Binding TransportistaID}" 
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Fila 2 -->
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="5">
                    <TextBlock Text="Fecha Pedido:" FontWeight="Bold" Foreground="#81488a"/>
                    <DatePicker SelectedDate="{Binding FechaPedido}" 
                                Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1" Margin="5">
                    <TextBlock Text="Fecha Requerida:" FontWeight="Bold" Foreground="#81488a"/>
                    <DatePicker SelectedDate="{Binding FechaRequerida}" 
                                Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="1" Margin="5">
                    <TextBlock Text="Fecha Envío:" FontWeight="Bold" Foreground="#81488a"/>
                    <DatePicker SelectedDate="{Binding FechaEnvio}" 
                                Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Fila 3 -->
                <StackPanel Grid.Column="0" Grid.Row="2" Margin="5">
                    <TextBlock Text="Destinatario:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding Destinatario, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="2" Margin="5">
                    <TextBlock Text="Ciudad Destino:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding CiudadDestino, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="2" Margin="5">
                    <TextBlock Text="País Destino:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding PaisDestino, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Fila 4: Botones -->
                <StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" 
                            Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="➕ Nuevo" Command="{Binding NuevoCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#2ecc71" Foreground="White" FontWeight="Bold"/>
                    <Button Content="💾 Guardar" Command="{Binding GuardarCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#81488a" Foreground="White" FontWeight="Bold"/>
                    <Button Content="️ Eliminar" Command="{Binding EliminarCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#e74c3c" Foreground="White" FontWeight="Bold"/>
                    <Button Content="🔄 Recargar" Command="{Binding CargarCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#df95ba" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="1" ItemsSource="{Binding PedidosDT}" 
                  SelectedItem="{Binding SelectedPedido}" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="True" 
                  CanUserAddRows="False"
                  Background="#fedae7" 
                  BorderBrush="#81488a" 
                  BorderThickness="1"/>
    </Grid>
</UserControl>