<UserControl x:Class="NeptunoApp_Lab06.Views.VistaProductos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Mantenimiento de Productos" Grid.Row="0" Padding="10" Margin="0,0,0,10"
                  BorderBrush="#81488a" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Nombre:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="5" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Precio:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding PrecioUnidad}" Padding="5" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Stock:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding UnidadesEnExistencia}" Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" 
                            Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="💾 Guardar" Command="{Binding GuardarCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#81488a" Foreground="White" FontWeight="Bold"/>
                    <Button Content="🗑️ Eliminar" Command="{Binding EliminarCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#e74c3c" Foreground="White" FontWeight="Bold"/>
                    <Button Content="🔄 Recargar" Command="{Binding CargarCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#df95ba" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ProductosDT}" 
                  SelectedItem="{Binding SelectedProducto}" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="True" 
                  CanUserAddRows="False"
                  Background="#fedae7" 
                  BorderBrush="#81488a" 
                  BorderThickness="1"/>
    </Grid>
</UserControl>