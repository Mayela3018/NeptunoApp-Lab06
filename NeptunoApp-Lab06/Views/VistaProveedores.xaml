<UserControl x:Class="NeptunoApp_Lab06.Views.VistaProveedores"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtros de Búsqueda -->
        <GroupBox Header="Filtros de Búsqueda" Grid.Row="0" Padding="10" Margin="0,0,0,10"
                  BorderBrush="#81488a" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Nombre Contacto:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="5" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Ciudad:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="5" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Formulario de Mantenimiento -->
        <GroupBox Header="Mantenimiento de Proveedores" Grid.Row="1" Padding="10" Margin="0,0,0,10"
                  BorderBrush="#81488a" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 1 -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="5">
                    <TextBlock Text="Compañía:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding CompaniaNombre, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="5" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="5">
                    <TextBlock Text="Contacto:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding NombreContacto}" Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Fila 2 -->
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="5">
                    <TextBlock Text="Cargo:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding CargoContacto}" Padding="5" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="5">
                    <TextBlock Text="Dirección:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding Direccion}" Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Fila 3 -->
                <StackPanel Grid.Column="0" Grid.Row="2" Margin="5">
                    <TextBlock Text="Ciudad:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding Ciudad}" Padding="5" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="2" Margin="5">
                    <TextBlock Text="Código Postal:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding CodigoPostal}" Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Fila 4 -->
                <StackPanel Grid.Column="0" Grid.Row="3" Margin="5">
                    <TextBlock Text="País:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding Pais}" Padding="5" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="3" Margin="5">
                    <TextBlock Text="Teléfono:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,5,0,0"
                             PreviewTextInput="Telefono_PreviewTextInput"/>
                </StackPanel>

                <!-- Fila 5 -->
                <StackPanel Grid.Column="0" Grid.Row="4" Margin="5">
                    <TextBlock Text="Fax:" FontWeight="Bold" Foreground="#81488a"/>
                    <TextBox Text="{Binding Fax}" Padding="5" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Fila 6 - Botones -->
                <StackPanel Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" 
                            Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <Button Content="➕ Nuevo" Command="{Binding NuevoCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#2ecc71" Foreground="White" FontWeight="Bold"/>
                    <Button Content="💾 Guardar" Command="{Binding GuardarCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#81488a" Foreground="White" FontWeight="Bold"/>
                    <Button Content="🗑️ Eliminar" Command="{Binding EliminarCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#e74c3c" Foreground="White" FontWeight="Bold"/>
                    <Button Content="🔄 Recargar" Command="{Binding CargarCommand}" 
                            Width="120" Margin="5" Padding="10,5" 
                            Background="#df95ba" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Tabla de Proveedores -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding ProveedoresDT}" 
                  SelectedItem="{Binding SelectedProveedor}" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="True" 
                  CanUserAddRows="False"
                  Background="#fedae7" 
                  BorderBrush="#81488a" 
                  BorderThickness="1"/>
    </Grid>
</UserControl>